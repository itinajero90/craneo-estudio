{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "craneo-studio",
  "version": "0.2.4",
  "identifier": "com.itinajero.craneostudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OSSO · Craneo Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' blob: data:",
        "connect-src": "'self' blob: data: ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: ws: http://localhost:* https: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Visor 3D de craneo humano con herramientas de dibujo",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxM0MxREQ2RTc5RTU0QzQKUldURVZKN24xaDA4d1RmWURjYWRXR0NKR1hqWDlTZzFvdG1SZ1g4eEdWcHhaOXRySGhwL1VQaUsK",
      "endpoints": [
        "https://craneo-studio.vercel.app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}