{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "craneo-studio",
  "version": "0.2.3",
  "identifier": "com.itinajero.craneostudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OSSO · Craneo Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Visor 3D de craneo humano con herramientas de dibujo",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxM0MxREQ2RTc5RTU0QzQKUldURVZKN24xaDA4d1RmWURjYWRXR0NKR1hqWDlTZzFvdG1SZ1g4eEdWcHhaOXRySGhwL1VQaUsK",
      "endpoints": [
        "https://craneo-studio.vercel.app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}